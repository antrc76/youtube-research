# Copy this file to .env and fill in what you have. Nothing here is required
# to try the app in demo mode — see DEMO_MODE below.

# --- Demo mode -------------------------------------------------------------
# Set to "true" to seed a few sample YouTube Summaries and one completed
# Channel Research run (with a sample chat thread) on first start, so the UI
# has something real to show with zero API keys configured. Submitting a
# genuinely new video or channel still requires the real keys below.
DEMO_MODE=false

# --- LLM: at least one of these two is required for real (non-demo) use ---
# Local model via Ollama (https://ollama.com) — free, no API key, used first
# for prompts under LOCAL_TOKEN_BUDGET tokens (default 6000).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:7b

# Anthropic — used when a prompt exceeds LOCAL_TOKEN_BUDGET, or as your only
# model if you don't run Ollama. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- YouTube Data API --------------------------------------------------------
# Required for Channel Research (listing a channel's uploads). Create a key
# at https://console.cloud.google.com/apis/credentials (enable "YouTube Data
# API v3" first). Free tier is generous for personal use.
YOUTUBE_API_KEY=

# --- Storage -----------------------------------------------------------------
# Where the SQLite database and the analysis cache file live. Must be
# writable — this is the whole fix for the analysis-cache bug this repo's
# README explains. Defaults to ./data if unset.
DATA_DIR=./data

# --- Optional profile for the "Analyse for me" panel -------------------------
# Path to a markdown file describing who you are / what you care about, so
# the analysis is personalised instead of generic. See profile.example.md.
# Leave unset to skip personalisation entirely.
PROFILE_PATH=./profile.md

# --- Optional: "Listen" text-to-speech (ElevenLabs) --------------------------
# Entirely optional and OFF by default — the Listen button only renders when
# ELEVENLABS_API_KEY is set (and never in DEMO_MODE, even if a real key is
# also set). Free tier works fine. Get a key at https://elevenlabs.io.
ELEVENLABS_API_KEY=
# Optional — defaults to ElevenLabs' premade "Rachel" voice if left blank.
ELEVENLABS_VOICE_ID=

# --- Optional: save-to-playlist queue poller ---------------------------------
# Entirely optional and OFF by default. Only starts if YOUTUBE_QUEUE_PLAYLIST_ID
# is set AND both OAuth variables below point at files that exist. See the
# README's "Enabling the queue poller" section for how to create these.
YOUTUBE_QUEUE_PLAYLIST_ID=
YOUTUBE_OAUTH_CLIENT_PATH=
YOUTUBE_OAUTH_TOKEN_PATH=
YOUTUBE_QUEUE_POLL_INTERVAL_MS=
YOUTUBE_QUEUE_MAX_ATTEMPTS=
